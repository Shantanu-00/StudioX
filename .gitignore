# --- Local-only material (never published) ---------------------------------
# Hackathon research, notes, the friction log and install evidence.
/docs/local/

# Credentials and environment configuration.
.env
.env.*
!.env.example
!.env.sample
/.aws/

# Local AI-tool state.
/.codex/
/.agents/
/.claude/settings.local.json

# --- Build output and generated files ---------------------------------------
/build/
/dist/
/generated/
/buildinfo.json
CMakeUserPresets.json
.tmp/
coverage/
reports/

# --- Dependencies -----------------------------------------------------------
node_modules/
npm-debug.log*

# --- Editors and operating system -------------------------------------------
.idea/
.vscode/
*.iml
*.swp
.DS_Store

# Python bytecode (helper scripts)
__pycache__/
*.pyc

# Companion server uploads (user media)
/companion/uploads/

# Downloaded platform/vendor reference material (not ours to redistribute)
/docs/reference/

# Demo episode sources and encodes (large; published separately). Not under
# assets/: the Vega build packs that folder into the .vpkg.
/media/

# Devpost drafts (personal answers and unverified claims); publish selectively
/submission/

# Third-party podcast transcripts used only for local pipeline testing (not ours to publish)
/review/transcript/
/review/strandswinners/

# Local TV config holding the live access code (never commit)
/src/config.local.ts

# AgentCore CLI deployed state (holds the AWS account ID) and account targets
/backend/agents/agentcore/.cli/
/backend/agents/agentcore/aws-targets.json

# Tool caches
.pytest_cache/
.ruff_cache/

# Machine-specific npm settings (local prefix path)
/.npmrc

# Generated AgentCore LLM reference context (vendor-generated)
/backend/agents/agentcore/.llm-context/
# Agent build staging cache
/backend/agents/agentcore/.cache/

# Local review screenshots (curated copies live in docs/images/)
/review/
